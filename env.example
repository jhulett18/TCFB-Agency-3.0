# TCFB Agency 3.0 Environment Variables
# Copy this file to .env and fill in your actual values

# Google Maps API Key (Required)
# Get your API key from: https://console.cloud.google.com/apis/credentials
REACT_APP_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Microsoft Graph API (Optional - for future use)
# Get these from your Azure AD app registration
REACT_APP_MICROSOFT_CLIENT_ID=your_microsoft_client_id_here
REACT_APP_MICROSOFT_TENANT_ID=your_microsoft_tenant_id_here

# App Configuration (Optional)
REACT_APP_APP_NAME=TCFB Agency Finder
REACT_APP_APP_VERSION=3.0.0
REACT_APP_ENVIRONMENT=production

# Build Configuration (Optional)
# Set to 'true' to disable file hashing in production builds
GENERATE_SOURCEMAP=false
DISABLE_ESLINT_PLUGIN=true

# Analytics (Optional - for future use)
# REACT_APP_GOOGLE_ANALYTICS_ID=your_ga_id_here 